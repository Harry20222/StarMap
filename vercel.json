{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "app:app",
      "devCommand": "python app.py",
      "functions": {
        "app.py": {
          "includeFiles": "{results/markers.json,results/measurements.json}",
          "excludeFiles": "{data/**,frontend/**,tests/**,my_venv/**,.venv/**,.pytest_cache/**,results/*.png,results/*.jpg}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "app" } },
    { "source": "/api/(.*)", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
